0x5D3BA0 = MsgText_AddMessageHook, 6
0x5D49A0 = MOExperience_MsgListEntry, 6
; 原生编辑行汇总: 两个落点 (0x5D4A8D 跳过 / 0x5D49BF 进入), 永不返回 0, 见 ChatEdit.cpp
0x5D49B4 = ChatEdit_HideNative, 3
0x5D4A94 = MOExperience_MessageDrawHook, 7
0x777998 = MOExperience_WheelHook, 6
0x533F50 = MOExperience_SidebarHook, 5
; 单人聊天框 (跳过 session 检查), 见 ChatEdit.cpp
0x55E477 = ChatEdit_ChatSp1, 5
0x55E62F = ChatEdit_ChatSp2, 6
0x55E693 = ChatEdit_ChatSp3, 6
0x55E746 = ChatEdit_ChatSp4, 5
0x732A85 = TypeSelect_SetCtx, 7
0x732B28 = TypeSelect_SetCtx, 6
0x465D40 = TypeSelect_BuildingGate, 6
0x732C20 = TypeSelect_Clear, 8
; 左键切换清产压制 (只跳原生地址, E8 事件构造点一律不碰, 见 notes)
0x6AB689 = BQ_QueueClick, 5
; 暂停块入口也剥离 (Ares 上游 LoadCameo2 可能绕过 H0, 此处绕不过)
0x6AB0C1 = BQ_PausePeel, 6
; 右键: N>1 直接减数不暂停(暂停检查点), N==1 走原生暂停取消
0x6AB197 = BQ_CancelPeel, 8
0x6AAE44 = BQ_DarkDispatchPeel, 6
0x6AAFE1 = BQ_DarkPauseSeen, 5
; 右键取消: 只钩无rel 的分支入口做本地剥离, E8 事件构造点一律不碰
; (0x6AA7E7 / 0x6AB1B5 / 0x6AB231 / 0x6AB1FF / 0x6AAFDC 全部撤钩, 见 notes)
0x6AB6CE = BQ_FreeShift, 10
0x6A9C86 = BQ_ShowCount, 5
0x6A9C6C = BQ_DrawNullFac, 6
; 工厂空时本地数照显示 (建筑页没下单则槽位无工厂, 防御页连带被跳过)
; 建造提示追加耗时/耗电 (退出点 mov eax,TooltipBuffer, 纯传送5B, 见 ToolTip.cpp)
0x6A93D9 = ToolTip_Extend, 5
; 提示盒钳制(FillRect 经mov+间接call 无rel 5B, 出屏整体平移, 见 ToolTip.cpp)
0x478FDC = ToolTip_Clamp, 5
; 字形 advance 修正 (0x4346C0 查表头5B 无rel, PUA 回图标步长, 见 ToolTip.cpp)
0x4346C0 = ToolTip_AdvFix, 5
; 超武侧栏点击吞没 (DisplayClass::ProcessClickCoords 内, Phobos SkipOnNewButtons 同点;
; 落栏内跳 0x6925FC 防误下单, 余者跑原版, 见 SWSBar.cpp)
0x692419 = SWS_ClickGate, 7
; 超武侧栏的"合并规则"快照: SuperWeaponTypeClass::LoadFromINI 入口 (6 字节 =
; sub esp,0x3F0), 取 this(ECX) 与栈上的 pINI, 当场读 SW.ShowCameo /
; SW.ManualFire / SW.UseAITargeting / SidebarPCX 等键。地图内嵌 ini 新增或改写的
; 超武只有这一条路读得到 (INI_Rules 只有基础规则那份), 见 SWSBar.cpp
; "合并规则的快照"。恒返回 0 = 跑原指令。
; 小地图点击 (FullMap): 同一函数里另落一道门 (6 字节 = push ecx / mov ecx,0x87F7E8),
; 落点雷达矩形内就自己调引擎原生 RadarClass::Action 跳转并跳 0x6925FC 吞掉,
; 见 src/GUI/FullMap.cpp 的"小地图点击: 自己接手 + 吞掉穿透"
0x692406 = FullMap_RadarClickGate, 6

; 维修简化: 维修快捷键 ToggleRepariModeCommandClass::Execute 吞 Ctrl (落 ret 4)
0x536FA0 = RepairAll_HotKey, 7
; 侧栏维修图标 (egui_BUTTON_REPAIR 0x8065 分支) 吞 Ctrl (落分支公共尾 jmp)
0x6A78D9 = RepairAll_Button, 6
; 单人暂停/步进 (仅遭遇战/战役, 联机空转; PauseEnable 只定按钮初始显示),
; 见 src/GUI/PauseView.cpp 与 Phobos FrameByFrame。
; MainLoop 入口 (0x55D360, 首 5B 单指令 mov al,[IsActive]):
; 暂停且无步进时跑迷你循环后跳 0x55DEDB (ret) 出本轮;
; 步进帧入口扣数放行一轮原循环。Logic/帧存/限速整轮不跑。
0x55D360 = PV_MainGate, 5
; 雷达事件行点击门 (DisplayClass::ProcessClickCoords 内 0x69234B, 5 字节 =
; mov eax,[ebp] / test eax,eax, 都是无副作用的读, 门落点 0x6925FC 栈形对齐)。
; 落在"操作与战斗提示"里的雷达事件行上就跳视口到该事件格并吞掉这次地图点击;
; 否则返回 0 跑原指令 (下面 0x692350 的 jl 出界判据一点没动)。见 MsgText.cpp
0x69234B = MsgText_RadarClickGate, 5
; 聚集点多段路径 (Z + 折线), 见 src/RallyPath.cpp
; 门: CellClickedAction 聚集点分支 (6B)。按住 Z 吞原生单点令改记折线, 余者放行。
0x44377E = RallyPath_GateHook, 6
; 出厂: BuildingClass::ExitObject (虚表第 64 项) 序言, WhatAmI 分派前, 载具/步兵/飞机全命中。
; 13B 只读 EDI (被调用者保存), 无须还原寄存器; 首条禁读 EAX/ECX/EDX。
0x443C7D = RallyPath_ExitHook, 13

; 无法攻击的单位不再冲向目标: FootClass::ObjectClickedAction 的
; NoMove(action==2) 处理器入口 0x4D77BD (6B = mov edx,[ebx] + lea eax,[esp+0x74], 无 rel)。
; ESI=this, EBX=pTarget; 目标非本家非盟友就跳 epilogue 0x4D7CC0 (停原地)。
; 见 src/NoApproach.cpp
0x4D77BD = NoApproach_Hook, 6
